<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">

    <!-- Outer Tech Data Ring -->
    <path
        android:pathData="M256,71 a185,185 0 1,0 0,370 a185,185 0 1,0 0,-370"
        android:strokeColor="#14FFFFFF"
        android:strokeWidth="2" />
        
    <!-- Dynamic Audio / Energy Ring -->
    <path
        android:pathData="M256,116 a140,140 0 1,0 0,280 a140,140 0 1,0 0,-280"
        android:strokeWidth="10">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startY="512"
                android:startX="0"
                android:endY="0"
                android:endX="512"
                android:type="linear">
                <item android:offset="0" android:color="#00f2fe" />
                <item android:offset="0.5" android:color="#4facfe" />
                <item android:offset="1" android:color="#f093fb" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Center Glass Hexagon -->
    <path
        android:pathData="M 256 156 L 342 206 L 342 306 L 256 356 L 169 306 L 169 206 Z"
        android:fillColor="#0AFFFFFF"
        android:strokeColor="#4DFFFFFF"
        android:strokeWidth="2" />
        
    <!-- Play Button -->
    <path
        android:pathData="M 230 206 C 220 200 210 206 210 218 L 210 294 C 210 306 220 312 230 306 L 298 268 C 308 262 308 250 298 244 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startY="0"
                android:startX="0"
                android:endY="512"
                android:endX="512"
                android:type="linear">
                <item android:offset="0" android:color="#ffffff" />
                <item android:offset="0.4" android:color="#f8fafc" />
                <item android:offset="0.7" android:color="#818cf8" />
                <item android:offset="1" android:color="#c084fc" />
            </gradient>
        </aapt:attr>
    </path>
</vector>