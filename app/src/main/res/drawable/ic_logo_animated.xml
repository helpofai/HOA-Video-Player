<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/ic_logo_static">

    <!-- Outer Tech Data Ring (spin-reverse 25s) -->
    <target android:name="outer_tech_ring">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="25000"
                android:propertyName="rotation"
                android:valueFrom="0"
                android:valueTo="-360"
                android:repeatCount="infinite"
                android:interpolator="@android:anim/linear_interpolator" />
        </aapt:attr>
    </target>

    <!-- Inner dashed ring (spin-slow 18s) -->
    <target android:name="inner_dashed_ring">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="18000"
                android:propertyName="rotation"
                android:valueFrom="0"
                android:valueTo="360"
                android:repeatCount="infinite"
                android:interpolator="@android:anim/linear_interpolator" />
        </aapt:attr>
    </target>

    <!-- Dynamic Audio / Energy Ring (spin-constant 8s) -->
    <target android:name="dynamic_audio_ring">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="8000"
                android:propertyName="rotation"
                android:valueFrom="0"
                android:valueTo="360"
                android:repeatCount="infinite"
                android:interpolator="@android:anim/linear_interpolator" />
        </aapt:attr>
    </target>

    <!-- Inner fast ring (spin-fast 6s cubic bezier) -->
    <target android:name="inner_fast_ring">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="6000"
                android:propertyName="rotation"
                android:valueFrom="0"
                android:valueTo="360"
                android:repeatCount="infinite"
                android:interpolator="@android:anim/accelerate_decelerate_interpolator" />
        </aapt:attr>
    </target>
    
    <!-- Orbit 1 (spin 7s) -->
    <target android:name="orbit_1">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="7000"
                android:propertyName="rotation"
                android:valueFrom="0"
                android:valueTo="360"
                android:repeatCount="infinite"
                android:interpolator="@android:anim/linear_interpolator" />
        </aapt:attr>
    </target>

    <!-- Orbit 2 (spin reverse 11s) -->
    <target android:name="orbit_2">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="11000"
                android:propertyName="rotation"
                android:valueFrom="0"
                android:valueTo="-360"
                android:repeatCount="infinite"
                android:interpolator="@android:anim/linear_interpolator" />
        </aapt:attr>
    </target>

    <!-- Futuristic Center Glass Hexagon (spin-slow 18s) -->
    <target android:name="hexagon">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="18000"
                android:propertyName="rotation"
                android:valueFrom="0"
                android:valueTo="360"
                android:repeatCount="infinite"
                android:interpolator="@android:anim/linear_interpolator" />
        </aapt:attr>
    </target>

    <!-- 3D Beveled Play Button (pulse-soft 2.5s) -->
    <target android:name="play_button">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:duration="2500"
                    android:propertyName="scaleX"
                    android:valueFrom="0.95"
                    android:valueTo="1.08"
                    android:repeatCount="infinite"
                    android:repeatMode="reverse"
                    android:interpolator="@android:anim/accelerate_decelerate_interpolator" />
                <objectAnimator
                    android:duration="2500"
                    android:propertyName="scaleY"
                    android:valueFrom="0.95"
                    android:valueTo="1.08"
                    android:repeatCount="infinite"
                    android:repeatMode="reverse"
                    android:interpolator="@android:anim/accelerate_decelerate_interpolator" />
            </set>
        </aapt:attr>
    </target>

</animated-vector>
